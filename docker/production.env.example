# Copy to docker/production.env and fill with deployment values. Never commit production.env.
IMAGE_TAG=2026.10.29
DOMAIN=monitoring.example.com
ACME_EMAIL=operations@example.com
AUTH_GATEWAY_UPSTREAM=http://host.docker.internal:4180
AUTH_GATEWAY_PATH=/oauth2/auth

# Use a URL-safe random password (letters, digits, _ and -) because this value is used in URLs.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password

# Managed Qdrant endpoint and API key. Do not put these in VITE_* variables.
QDRANT_URL=https://your-cluster.region.cloud.qdrant.io:6333
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_COLLECTION_NAME=face_embeddings

# Use independent high-entropy, URL-safe tokens for each role.
VAULT_ROOM_API_KEY=replace-with-vault-operator-token
VAULT_ALERT_PRODUCER_TOKEN=replace-with-vault-producer-token
BRANCH_ALERT_PRODUCER_TOKEN=replace-with-branch-producer-token
ALERT_SERVICE_OPERATOR_TOKEN=replace-with-alert-operator-token
