# PostgreSQL stores structured person and application records.
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/face_recognition_db

# Qdrant Cloud stores face embeddings. Use the cluster URL and API key from
# the Qdrant Cloud console. Never commit a real API key.
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=face_embeddings

# ArcFace emits 512 dimensions and the existing configured cosine-distance
# threshold remains 0.68. Calibrate FACE_RECOGNITION_THRESHOLD on your dataset.
FACE_RECOGNITION_MODEL=ArcFace
FACE_DISTANCE_METRIC=cosine
FACE_RECOGNITION_THRESHOLD=0.68

# Video / Tracking Settings
RECOGNITION_INTERVAL_FRAMES=15
MAX_TRACK_MISSED_FRAMES=15
WEBCAM_INDEX=0
RTSP_URLS=[]
RTSP_RECONNECT_ATTEMPTS=5
RTSP_RECONNECT_DELAY_SECONDS=2.0
RTSP_READ_TIMEOUT_MS=5000
VIDEO_UPLOAD_DIR=uploads/video-input
VIDEO_OUTPUT_DIR=uploads/video-output

