# Local development ports (see docs/stage-9-frontend-integration-report.md). No secrets belong in VITE_* values:
# everything prefixed VITE_ is copied into the public browser bundle.

# Vault Monitoring backend (backend/use_cases/vault_monitoring). VITE_API_BASE_URL is still read as a fallback.
VITE_VAULT_API_BASE_URL=http://localhost:8010

# Branch Exterior Monitoring backend (backend/use_cases/branch_exterior)
VITE_BRANCH_EXTERIOR_API_BASE_URL=http://localhost:8011

# POC shared operator key for Vault's vault-room, alert, incident and evidence APIs. Browser bundle values are
# public: use only for local POC, set to the same value as VAULT_ROOM_API_KEY in the Vault .env.
# VITE_VAULT_ROOM_API_KEY=

# Alert Service (backend/services/alert_service). The browser talks to the same-origin path /alert-service,
# which the Vite dev/preview server proxies to ALERT_SERVICE_URL with the operator token added server-side.
# Leave VITE_ALERT_SERVICE_BASE_URL unset unless a reverse proxy supplies the credential.
# VITE_ALERT_SERVICE_BASE_URL=/alert-service
# Offer acknowledge / resolve / dismiss on Alert Service alerts (default false: Vault and Branch remain
# the lifecycle authority for their own alerts during shadow ingestion).
# VITE_ALERT_SERVICE_ACTIONS_ENABLED=false
# VITE_ALERT_POLL_MS=10000

# Used only by vite.config.js (Node side, never sent to the browser). Do not prefix these with VITE_.
ALERT_SERVICE_URL=http://127.0.0.1:8012
# Operator token configured in the Alert Service ALERT_OPERATOR_CREDENTIALS. Put the real value in .env.local.
# ALERT_SERVICE_OPERATOR_TOKEN=
