# Copy this file to .env and adjust as needed.
# None of these are required to start the POC - sensible defaults are used
# (SQLite database file, local storage folder, motion-based detector).

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
APP_NAME="Branch Exterior Monitoring & Anomaly Detection"
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=*
# Optional simple shared-secret header check for API routes. Leave blank to disable.
API_KEY=

# ---------------------------------------------------------------------------
# Database - the system can be pointed at ANY of the engines below by
# changing DB_ENGINE and the matching credential fields. This can also be
# done live from the Settings page in the UI (POST /api/settings/database),
# which writes to backend/config/db_config.json and reconnects.
# Supported values: sqlite | postgres | mysql | oracle | mongodb
# ---------------------------------------------------------------------------
DB_ENGINE=sqlite

# Used when DB_ENGINE=sqlite (default, zero setup)
DB_SQLITE_PATH=storage/app.db

# Used when DB_ENGINE=postgres | mysql | oracle | mongodb
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=branch_monitoring

# Oracle-only (service name instead of a plain database name), optional
DB_ORACLE_SERVICE_NAME=

# ---------------------------------------------------------------------------
# Storage (relative to backend/ unless absolute)
# ---------------------------------------------------------------------------
STORAGE_DIR=storage
SNAPSHOT_DIR=storage/snapshots
CLIP_DIR=storage/clips
UPLOAD_DIR=storage/uploads
SAMPLE_VIDEO_DIR=storage/sample_videos
GUARD_FACE_DIR=storage/guard_faces

# ---------------------------------------------------------------------------
# true  = only the video picked in the Live Monitoring dropdown is processed (low CPU)
# false = every enabled camera is processed at the same time
# ---------------------------------------------------------------------------
SINGLE_ACTIVE_CAMERA=true

# ---------------------------------------------------------------------------
# Detection pipeline  (restart the server after changing any of these)
# ---------------------------------------------------------------------------
# --- Detection ---------------------------------------------------------------
PERSON_DETECTOR_BACKEND=rfdetr
# nano = fastest, weakest on small/far people.  small = recommended starting point for accuracy.
# If the live FPS tile drops below ~3, go back to nano.
RFDETR_MODEL_SIZE=small
# Device (auto|cpu|cuda) is set centrally in <repo>/config/inference.yaml; override with INFERENCE_DEVICE.
# RFDETR_DEVICE is a deprecated per-model override for the RF-DETR detectors only.
RFDETR_THRESHOLD=0.40
RFDETR_LOW_THRESHOLD=0.20
DETECT_EVERY_N_FRAMES=1        # keep at 1 - sparse detection breaks tracking of running/jumping people
PROCESSING_FPS=10              # upper limit; real speed is whatever the CPU manages
FRAME_WIDTH=1280               # analysis width (never upscaled). Tiny far-away people need pixels.
DETECT_TILES=2x2                # also scan wide frames in 2x2 tiles so tiny people reach the model bigger (off | 2x1 | 2x2 | 3x2)
DETECT_TILE_EVERY=3             # ...every 3rd pass (each tile pass costs extra CPU)
CPU_THREADS=0                  # 0 = auto (cores - 2) so the web server and pages stay responsive

# --- Weapons -----------------------------------------------------------------
# Zone alerts: what counts as suspicious AT a zone
ZONE_GROUP_MIN_PEOPLE=3
ZONE_GROUP_SECONDS=15           # 3+ people at the zone this long = gathering alert
ZONE_STARE_GLANCES=3            # glances toward the zone within 12 s
ZONE_STARE_SECONDS=4            # ... or one continuous look this long
ZONE_RUSH_BH_PER_S=1.1          # running speed toward a zone
ZONE_TAMPER_AGITATION=2.5       # vigorous hand / arm movement while hands are on the zone

# Bags (backpack / handbag / suitcase) for the "unattended bag" rule
BAG_DETECTION_ENABLED=true
BAG_THRESHOLD=0.35
UNATTENDED_BAG_SECONDS=20

WEAPON_DETECTOR_ENABLED=true
WEAPON_COCO_CLASSES_ENABLED=true
WEAPON_COCO_THRESHOLD=0.45
WEAPON_CROP_PASS_ENABLED=true  # zoom-in check around each person (finds hand-held knives/bats)
WEAPON_CROP_THRESHOLD=0.35
WEAPON_CROP_EVERY_N_PASSES=2
WEAPON_CROP_MAX_PEOPLE=3
WEAPON_CONFIRM_HITS=3
# Guns: needs YOUR trained model - see backend/docs/WEAPON_TRAINING.md
WEAPON_MODEL_PATH=
WEAPON_MODEL_SIZE=nano         # the size you trained with (nano/small/medium/large/base)
WEAPON_CLASS_NAMES=gun,knife
WEAPON_CUSTOM_THRESHOLD=0.45

# --- Pose / actions ----------------------------------------------------------
POSE_ENABLED=true
POSE_EVERY_N_FRAMES=1
POSE_MAX_PEOPLE=6
FIGHT_AGITATION_THRESHOLD=3.0  # LOWER = catches more fights (and more false alarms)
FIGHT_STRIKE_SPEED=3.5
RUN_BODYHEIGHTS_PER_S=1.1      # LOWER = more people count as running
FACE_RECOGNITION_ENABLED=true


# ---------------------------------------------------------------------------
# Notifications (optional). If NOTIFY_WEBHOOK_URL is set, every alert is also
# POSTed there as JSON (compatible with Slack/Teams incoming webhooks).
# ---------------------------------------------------------------------------
NOTIFY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Alert Service publication (optional). Disabled unless BOTH values are set.
# New events are published one-way to Alert Service Contract v1 (POST /api/v1/alerts) with
# a producer bearer token whose server-side identity is use_case=branch_exterior,
# producer=branch-exterior-monitoring. Failed deliveries stay in storage/alert_outbox and are
# retried. Do not also configure ALERT_NOTIFICATION_WEBHOOK_URL on the Alert Service while
# NOTIFY_WEBHOOK_URL is set here, or each alert is announced twice.
# ---------------------------------------------------------------------------
ALERT_SERVICE_BASE_URL=
ALERT_SERVICE_TOKEN=
ALERT_SERVICE_TIMEOUT_SECONDS=3.0
ALERT_SERVICE_POLL_SECONDS=2.0
