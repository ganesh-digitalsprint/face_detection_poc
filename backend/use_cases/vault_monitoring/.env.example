# PostgreSQL stores structured person and application records.
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/face_recognition_db

# Qdrant Cloud stores face embeddings. Use the cluster URL and API key from
# the Qdrant Cloud console. Never commit a real API key.
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=face_embeddings

# ML and processing profiles live in config/models.yaml.
# Grill Gate diagnostic verbosity uses the shared stdout handler; choose DEBUG for per-frame details.
GRILL_GATE_LOG_LEVEL=DEBUG
# Optional independent overrides:
# RECOGNITION_MODEL=Facenet
# PERFORMANCE_PROFILE=balanced
# Device selection lives in <repo>/config/inference.yaml; override with INFERENCE_DEVICE=auto|cpu|cuda.
# COMPUTE_DEVICE is a deprecated legacy override for DeepFace only.

# Video / Tracking Settings
WEBCAM_INDEX=0
RTSP_URLS=[]
# Optional hostname/domain allowlist for user-entered RTSP sources. If unset, dynamic RTSP
# sources are limited to private network addresses (camera LANs).
RTSP_ALLOWED_HOSTS=[]
RTSP_RECONNECT_ATTEMPTS=5
RTSP_RECONNECT_DELAY_SECONDS=2.0
RTSP_READ_TIMEOUT_MS=5000
VIDEO_UPLOAD_DIR=uploads/video-input
VIDEO_OUTPUT_DIR=uploads/video-output
MAX_VIDEO_UPLOAD_MB=500
GRILL_GATE_VIDEO_UPLOAD_DIR=uploads/grill-gate-videos
GRILL_GATE_VIDEO_MAX_CONCURRENT=1
GRILL_GATE_VIDEO_MAX_QUEUED=3


# Developer Liveness Test Lab API (/api/v1/liveness-test). Keep false in production.
LIVENESS_TEST_ENABLED=true

# Optional vault authorization overrides. The config/models.yaml values apply when unset.
# VAULT_REQUIRED_PERSONS=1
VAULT_ALLOW_MODE_SELECT=true

# Shared POC operator key for /api/v1/vault-room, alerts, incidents and evidence.
# Configure the same value as frontend/.env.local VITE_VAULT_ROOM_API_KEY.
VAULT_ROOM_API_KEY=

# Cloudinary evidence storage (authenticated delivery; never commit real credentials).
# Obtain these values from the Cloudinary console API Keys page.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_EVIDENCE_FOLDER=vault-monitoring
EVIDENCE_MAX_UPLOAD_BYTES=10485760
EVIDENCE_UPLOAD_TIMEOUT_SECONDS=20
EVIDENCE_UPLOAD_RETRIES=2
EVIDENCE_URL_TTL_SECONDS=300
EVIDENCE_SPOOL_DIR=var/evidence-spool
# Shared Alert Service. Set both tokens from matching Alert Service credential-map entries.
ALERT_SERVICE_BASE_URL=http://127.0.0.1:8012
# Producer identity must be use_case=grill_gate, producer=grill-gate-monitoring.
ALERT_SERVICE_TOKEN=
# Operator credential must include grill_gate in its use_cases scope.
ALERT_SERVICE_OPERATOR_TOKEN=
GRILL_GATE_ALERT_OUTBOX_DIR=var/grill-gate-alert-outbox

# Dedicated Common Alert Service producer credential scoped to grill_gate. Never use Vault's token.
GRILL_GATE_ALERT_SERVICE_TOKEN=
