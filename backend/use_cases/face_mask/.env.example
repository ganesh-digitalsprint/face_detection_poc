# Copy to .env. Thresholds live in config/face_mask.yaml, not here.
APP_NAME="Face Mask Monitoring"
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=*
# Optional shared secret (X-API-Key). Leave blank to disable.
API_KEY=
# Database: SQLite by default. For PostgreSQL set DB_URL=postgresql+asyncpg://user:pass@host:5432/db
DB_URL=
DB_SQLITE_PATH=storage/app.db
# Override the YAML location if needed
FACE_MASK_CONFIG_PATH=
# Alert Service (disabled unless both are set). Token must be registered in ALERT_PRODUCER_CREDENTIALS with use_case=face_mask.
ALERT_SERVICE_BASE_URL=
ALERT_SERVICE_TOKEN=
ALERT_SERVICE_TIMEOUT_SECONDS=3.0
