# Common Alerts uses a dedicated database on the existing PostgreSQL server.
ALERT_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/alert_service

# Existing PoC keys are composed into these maps by start-all.ps1 for local runs.
# Deployed environments should provide equivalent JSON maps without committing secrets.
ALERT_PRODUCER_CREDENTIALS={}
# Notification-management endpoints additionally require branch_ids, for example:
# {"operator-token":{"actor_id":"security-admin","use_cases":["*"],"branch_ids":["branch-id"]}}
ALERT_OPERATOR_CREDENTIALS={}

ALERT_NOTIFICATION_WEBHOOK_URL=
ALERT_NOTIFICATION_POLL_SECONDS=2
ALERT_NOTIFICATION_MAX_ATTEMPTS=8

# Gmail SMTP Configuration
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Fedbank Security Alerts
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
